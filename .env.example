# Store credentials, issued separately for sandbox and live.
# The environment flag and the credentials must always move together.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Optional.
# SSLCOMMERZ_URL=                 # pin a host or proxy, overriding the one the flag implies
# SSLCOMMERZ_TIMEOUT_MS=15000     # upper bound on one gateway request
# SSLCOMMERZ_AMOUNT_TOLERANCE=1   # allowed amount difference, in currency units

# Sandbox credentials for the integration suite (it never runs against live).
# TEST_SSLCOMMERZ_STORE_ID=
# TEST_SSLCOMMERZ_STORE_PASSWORD=
